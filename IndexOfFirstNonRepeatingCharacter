//Problem Statement: Given a string s, find the first non-repeating character in it and return its index. If it does not exist, return -1.
//Example: s = "loveleetcode" $\rightarrow$ 
//Output: 2 (character 'v').
import java.util.stream.Collectors;
import java.util.*;

public class IndexOfFirstNonRepeatingCharacter
{
	public static void main(String[] args) {
	    String s = "loveleetcode";
	    Map<Character, Long> frequencyMap= s.chars().mapToObj(c -> (char) c)
	            .collect(Collectors.groupingBy(c -> c, LinkedHashMap::new, Collectors.counting()));
		
		int index= s.chars().mapToObj(c -> (char) c).filter(c -> frequencyMap.get(c)==1)
		            .map(c->s.indexOf(c))//.map(s::indexOf)
		            .findFirst().orElse(-1);
        System.out.println("index of first non-repeating character is: " + index);        		            
	}
}
